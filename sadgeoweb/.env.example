# Exemplo de variáveis; configure a IDE ou exporte-as. Não é carregado automaticamente.
# Nunca coloque credenciais reais neste arquivo versionado.
SADGEO_DB_URL=jdbc:oracle:thin:@//oracle.example.org:1521/SERVICE_NAME
SADGEO_DB_USERNAME=
SADGEO_DB_PASSWORD=
SADGEO_DB_SCHEMA=BDG_VALIDA

SADGEO_LDAP_HOST=ad.example.org
SADGEO_LDAP_PORT=636
SADGEO_LDAP_DOMAIN=example.org
SADGEO_LDAP_BASE_DN=DC=example,DC=org
SADGEO_LDAP_CONNECT_TIMEOUT_MS=5000
SADGEO_LDAP_READ_TIMEOUT_MS=10000
# Override opcional; deixe vazio para usar HOST/PORT.
SADGEO_LDAP_URL=
# Truststore institucional opcional; certificados precisam ser confiáveis.
# JAVA_TOOL_OPTIONS=-Djavax.net.ssl.trustStore=/caminho/truststore.p12 -Djavax.net.ssl.trustStoreType=PKCS12

# Rótulo opcional do profile no rodapé (padrão derivado do profile ativo).
# SADGEO_PROFILE_LABEL=Homologação
